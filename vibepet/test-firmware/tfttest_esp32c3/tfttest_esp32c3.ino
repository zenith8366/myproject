/*
 * TFT_AI_Logos.ino
 * 1.77" ST7735 128x160  +  ESP32-C3 SuperMini
 *
 * 接线：
 *   GND  → GND
 *   VCC  → 3.3V
 *   SCK  → GPIO 4   (硬件 SPI SCK)
 *   SDA  → GPIO 6   (硬件 SPI MOSI)
 *   RES  → GPIO 2
 *   RS   → GPIO 1   (DC / A0)
 *   CS   → GPIO 7
 *   LEDA → 3.3V     (背光常亮)
 *
 * 库（Arduino Library Manager）：
 *   Adafruit GFX Library
 *   Adafruit ST7735 and ST7789 Library
 *
 * 四个 Logo 来自 Wikimedia 官方 SVG（ChatGPT blossom / Claude spark /
 * DeepSeek 鲸 / Grok 2025 mark），下采样到 112x112、16 色自适应调色板、
 * 4bit RLE 写入 PROGMEM。
 * 每个画面停留约 3 秒，自上而下擦除后切下一张。
 *
 * 若花屏/偏色，改 TFT_INIT / TFT_ROTATION，或打开 INVERT。
 */

#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>

#define TFT_CS    7
#define TFT_RS    1     // DC
#define TFT_RES   2

// 1.77" 128x160 常见黑排/绿排。花屏先试 INITR_GREENTAB / INITR_REDTAB。
#define TFT_INIT      INITR_BLACKTAB
#define TFT_ROTATION  0
#define TFT_INVERT    0

Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_RS, TFT_RES);

static const uint8_t LOGO_W = 112;
static const uint8_t LOGO_H = 112;
static const int16_t LOGO_X = 8;
static const int16_t LOGO_Y = 8;

struct Logo {
  const char     *name;
  const uint16_t *palette;   // 16 x RGB565 PROGMEM
  const uint8_t  *rle;       // nibble: high=count-1 (1..16), low=index
  uint16_t        rleLen;
  uint16_t        holdMs;
  uint16_t        captionColor;
};

