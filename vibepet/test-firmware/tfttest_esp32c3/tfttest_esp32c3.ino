static const Logo LOGOS[] = {
  {
    "ChatGPT",
    chatgpt_pal,
    chatgpt_rle,
    3308,
    3000,
    0x7553
  },
  {
    "Claude",
    claude_pal,
    claude_rle,
    3551,
    3000,
    0xDBAA
  },
  {
    "DeepSeek",
    deepseek_pal,
    deepseek_rle,
    2499,
    3000,
    0x4B5F
  },
  {
    "Grok",
    grok_pal,
    grok_rle,
    2667,
    3200,
    0xFFFF
  }
};
static const uint8_t LOGO_COUNT = sizeof(LOGOS) / sizeof(LOGOS[0]);

static uint16_t pgmPalette(const uint16_t *pal, uint8_t i) {
  return pgm_read_word(pal + i);
}

// 把 4bit RLE 直接推到 ST7735 窗口
static void blitRle(const Logo &logo) {
  tft.startWrite();
  tft.setAddrWindow(LOGO_X, LOGO_Y, LOGO_W, LOGO_H);

  uint16_t remaining = (uint16_t)LOGO_W * (uint16_t)LOGO_H;
  uint16_t src = 0;
  uint16_t pal[16];
  for (uint8_t i = 0; i < 16; i++) pal[i] = pgmPalette(logo.palette, i);

  while (remaining && src < logo.rleLen) {
    uint8_t b = pgm_read_byte(logo.rle + src);
    src++;
    uint8_t count = (b >> 4) + 1;
    uint8_t idx = b & 0x0F;
    uint16_t color = pal[idx];
    if (count > remaining) count = (uint8_t)remaining;
    remaining -= count;
    tft.writeColor(color, count);
  }

  tft.endWrite();
}

static void drawCaption(const Logo &logo) {
  int16_t y = LOGO_Y + LOGO_H + 10;
  tft.fillRect(0, y - 2, 128, 160 - (y - 2), ST77XX_BLACK);
  tft.setTextSize(1);
  tft.setTextColor(logo.captionColor, ST77XX_BLACK);
  int16_t x1, y1;
  uint16_t w, h;
  tft.getTextBounds(logo.name, 0, 0, &x1, &y1, &w, &h);
  int16_t x = (128 - (int16_t)w) / 2;
  if (x < 0) x = 0;
  tft.setCursor(x, y);
  tft.print(logo.name);
}

static void wipeToBlack() {
  for (int16_t y = 0; y < 160; y += 4) {
    tft.fillRect(0, y, 128, 4, ST77XX_BLACK);
    delay(8);
  }
}

void setup() {
  Serial.begin(115200);
  
  // 1. 先给电源和屏幕足够的稳定时间（关键！）
  delay(300);          // 最少 200~500ms，建议先用 300

  // 2. 手动控制 RST 做一次硬件复位（强烈推荐）
  pinMode(TFT_RES, OUTPUT);
  digitalWrite(TFT_RES, LOW);
  delay(20);
  digitalWrite(TFT_RES, HIGH);
  delay(120);          // 复位后等待屏幕内部复位完成

  // 3. 初始化 SPI（可选但更稳）
  SPI.begin(4, -1, 6, 7);   // SCK=4, MOSI=6, SS=7

  // 4. 再初始化屏幕
  tft.initR(TFT_INIT);
  tft.setRotation(TFT_ROTATION);
  tft.setTextWrap(false);

#if TFT_INVERT
  tft.invertDisplay(true);
#endif

  // 5. 初始化后再清一次屏
  tft.fillScreen(ST77XX_BLACK);

  Serial.println("ESP32-C3 SuperMini + ST7735 ready");
}

void loop() {
  for (uint8_t i = 0; i < LOGO_COUNT; i++) {
    const Logo &logo = LOGOS[i];
    tft.fillScreen(ST77XX_BLACK);
    blitRle(logo);
    drawCaption(logo);
    delay(logo.holdMs);
    wipeToBlack();
    delay(180);
  }
}
